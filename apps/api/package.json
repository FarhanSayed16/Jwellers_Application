{
  "name": "@jwellers/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed:owner": "tsx src/scripts/seedOwner.ts",
    "seed:shop": "tsx src/scripts/seedShopConfig.ts",
    "seed": "tsx src/scripts/seedShopConfig.ts && tsx src/scripts/seedOwner.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "verify:db": "tsx src/scripts/verifyModels.ts",
    "verify:admin-auth": "tsx src/scripts/verifyAdminAuth.ts",
    "verify:customer-auth": "tsx src/scripts/verifyCustomerAuth.ts",
    "verify:rates": "tsx src/scripts/verifyRates.ts",
    "verify:catalog": "tsx src/scripts/verifyCatalog.ts",
    "verify:media": "tsx src/scripts/verifyMedia.ts",
    "verify:leads": "tsx src/scripts/verifyLeads.ts",
    "verify:phase14": "tsx src/scripts/verifyPhase14.ts",
    "verify:phase15": "tsx src/scripts/verifyPhase15.ts",
    "verify:chat": "tsx src/scripts/verifyChat.ts",
    "verify:fcm": "tsx src/scripts/verifyFcm.ts",
    "verify:phase22": "tsx src/scripts/verifyPhase22.ts",
    "verify:phase23": "tsx src/scripts/verifyPhase23.ts",
    "verify:phase24": "tsx src/scripts/verifyPhase24.ts",
    "smoke": "tsx src/scripts/smokeDeploy.ts",
    "check:live": "tsx src/scripts/checkLiveStack.ts",
    "mail:test": "tsx src/scripts/sendTestEmail.ts"
  },
  "dependencies": {
    "@sentry/node": "^9.47.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.10",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
