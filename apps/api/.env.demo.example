# Copy to a local override when dogfooding Demo (never commit real secrets).
# Prefer a dedicated Atlas DB name: .../demo_jewellers?...
NODE_ENV=development
PORT=4000
CLIENT_SLUG=demo

MONGODB_URI=mongodb://127.0.0.1:27017/demo_jewellers
JWT_ACCESS_SECRET=demo-access-secret-change-me-min-32-chars!
JWT_REFRESH_SECRET=demo-refresh-secret-change-me-min-32-chars!
OTP_PEPPER=demo-otp-pepper-change-me
OTP_DEV_BYPASS=true
OTP_DEV_CODE=123456

ADMIN_CORS_ORIGIN=http://localhost:3000

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FEATURE_CHAT=true
FEATURE_WHATSAPP=true
FEATURE_RATE_HISTORY=true
FEATURE_SIZE_GUIDE=true
FEATURE_OFFERS=true
FEATURE_CUSTOM_REQUESTS=true
FEATURE_HALLMARK=true

# Premium demo path (Phase 34) — enable on Demo dogfood:
FEATURE_RATE_API=true
FEATURE_WHATSAPP_BUSINESS_API=true
RATE_API_PROVIDER=mock
WA_BSP_DRY_RUN=true

SEED_OWNER_EMAIL=owner@demo.jewellers.local
SEED_OWNER_PASSWORD=ChangeMeOwner1!
SEED_OWNER_NAME=Demo Owner

MOBILE_MIN_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false

LEGAL_PRIVACY_URL=http://localhost:3000/legal/privacy
LEGAL_TERMS_URL=http://localhost:3000/legal/terms
LEGAL_DELETE_ACCOUNT_URL=http://localhost:3000/legal/delete-account
LEGAL_SUPPORT_EMAIL=support@demo.jewellers.local
MAINTENANCE_MODE=false

# After seed:
#   npm run seed -w @jwellers/api
#   npm run seed:demo-catalog -w @jwellers/api
# Premium demo: docs/phase34/PREMIUM_DEMO_SCRIPT.md
# Readiness: npm run verify:readiness -w @jwellers/api
