# Copy for Ratnaraj production / staging (never commit real secrets).
NODE_ENV=production
PORT=4000
CLIENT_SLUG=ratnaraj

# Dedicated DB name — do not reuse demo_jewellers
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/ratnaraj_jewellers?retryWrites=true&w=majority

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_PEPPER=
OTP_DEV_BYPASS=false

ADMIN_CORS_ORIGIN=https://YOUR-ADMIN.vercel.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

FCM_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# Match clients/ratnaraj/modules.json
FEATURE_CHAT=true
FEATURE_WHATSAPP=true
FEATURE_RATE_HISTORY=true
FEATURE_SIZE_GUIDE=true
FEATURE_OFFERS=true
FEATURE_CUSTOM_REQUESTS=true
FEATURE_HALLMARK=true
FEATURE_DIGITAL_BILLING=false
FEATURE_RAZORPAY_PAYMENTS=false

SEED_OWNER_EMAIL=owner@ratnaraj.jewellers.local
SEED_OWNER_PHONE=9999999999
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Ratnaraj Owner

MOBILE_MIN_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false
MOBILE_STORE_URL_ANDROID=

LEGAL_PRIVACY_URL=https://YOUR-ADMIN.vercel.app/legal/privacy
LEGAL_TERMS_URL=https://YOUR-ADMIN.vercel.app/legal/terms
LEGAL_DELETE_ACCOUNT_URL=https://YOUR-ADMIN.vercel.app/legal/delete-account
LEGAL_SUPPORT_EMAIL=hello@ratnarajjewellers.example

# After deploy:
#   CLIENT_SLUG=ratnaraj SEED_UPSERT=true npm run seed -w @jwellers/api
#   CLIENT_SLUG=ratnaraj npm run seed:ratnaraj-catalog -w @jwellers/api
#   SMOKE_BASE_URL=https://… npm run smoke -w @jwellers/api
