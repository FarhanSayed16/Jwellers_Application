# Copy for local dry-run — never commit secrets.
NODE_ENV=development
PORT=4000
CLIENT_SLUG=acme

MONGODB_URI=mongodb://127.0.0.1:27017/acme_jewellers
JWT_ACCESS_SECRET=acme-access-secret-change-me-min-32-chars!
JWT_REFRESH_SECRET=acme-refresh-secret-change-me-min-32-chars!
OTP_PEPPER=acme-otp-pepper-change-me
OTP_DEV_BYPASS=true
OTP_DEV_CODE=123456

ADMIN_CORS_ORIGIN=http://localhost:3000

FEATURE_CHAT=true
FEATURE_WHATSAPP=true
FEATURE_RATE_HISTORY=true
FEATURE_SIZE_GUIDE=true
FEATURE_OFFERS=true
FEATURE_CUSTOM_REQUESTS=true
FEATURE_HALLMARK=true

SEED_OWNER_EMAIL=owner@acme.jewellers.local
SEED_OWNER_PASSWORD=ChangeMeOwner1!
SEED_OWNER_NAME=Acme Jewellers Owner

MOBILE_MIN_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0

# After env is ready:
#   CLIENT_SLUG=acme npm run client:provision -w @jwellers/api
