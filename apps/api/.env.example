NODE_ENV=development
PORT=4000
# demo | ratnaraj — drives Cloudinary folder clients/<CLIENT_SLUG>/...
CLIENT_SLUG=demo

# --- Required in production (fail-fast). Dev may use placeholders. ---
# Prefer a dedicated Atlas database per product, e.g. .../ratnaraj_jewellers?...
# Do not reuse another app's DB name on the same cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/jwellers_demo
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
OTP_PEPPER=dev-otp-pepper-change-me
OTP_TTL_SECONDS=300
OTP_MAX_PER_PHONE_PER_HOUR=3
OTP_MAX_PER_IP_PER_HOUR=10
OTP_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
# Non-production only — fixed OTP when true (also returns when MSG91 empty)
OTP_DEV_BYPASS=false
# OTP_DEV_CODE=123456

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Upload policy: signed only. Folders: clients/<CLIENT_SLUG>/(items|chat|branding)
# MIME: jpeg/png/webp/heic · Admin max 10MB · Customer max 5MB (see GET /media/policy)

# Transactional email (enquiry / custom-request alerts). OTP still uses MSG91.
MAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_NOTIFY_TO=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

FCM_PROJECT_ID=
# Relative to apps/api — put JSON under secrets/ (gitignored)
# FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
# FCM_DRY_RUN=true  # verify scripts set this; leave false for live sends

ADMIN_CORS_ORIGIN=http://localhost:3000

# --- Feature flags (see docs/04 + clients/*/modules.json) ---
FEATURE_CHAT=true
FEATURE_WHATSAPP=true
FEATURE_RATE_HISTORY=true
FEATURE_SIZE_GUIDE=true
FEATURE_OFFERS=true
FEATURE_CUSTOM_REQUESTS=true
FEATURE_HALLMARK=true
FEATURE_DIGITAL_BILLING=false
FEATURE_RAZORPAY_PAYMENTS=false
FEATURE_RATE_API=false
FEATURE_MULTI_BRANCH=false
FEATURE_ANALYTICS=false
FEATURE_CRM_LIGHT=false
FEATURE_WHATSAPP_BUSINESS_API=false

# Premium: metals feed (FEATURE_RATE_API) — mock until RATE_API_KEY + vendor wired
# RATE_API_PROVIDER=mock
# RATE_API_KEY=
# RATE_API_DRY_RUN=true

# Premium: WhatsApp Business / BSP (FEATURE_WHATSAPP_BUSINESS_API) — dry-run without keys
# WA_BSP_PROVIDER=stub
# WA_BSP_API_KEY=
# WA_BSP_PHONE_NUMBER_ID=
# WA_BSP_DRY_RUN=true
# WA_TEMPLATE_RATES=morning_rates
# WA_TEMPLATE_OFFER=offer_broadcast

FEATURE_OLD_GOLD_EXCHANGE=false
FEATURE_ITEM_QR=false
FEATURE_SHARE_RATE_CARD=false
FEATURE_APPOINTMENTS=false
FEATURE_STORE_MODE=false
FEATURE_CURATED_BOARDS=false
FEATURE_SCHEMES=false
FEATURE_REFERRALS=false
FEATURE_PRICE_ALERTS=false
FEATURE_OFFLINE_CATALOG=false
FEATURE_I18N=false

# Printed QR deep-link scheme → jwellers://items/sku/SKU
APP_DEEP_LINK_SCHEME=jwellers

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Global API rate limit (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Optional Sentry (API). Empty = no-op.
SENTRY_DSN=
# SENTRY_RELEASE=jwellers-api@0.0.1

# Soft/force update — exposed on GET /config/public as appUpdate
MOBILE_MIN_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_FORCE_UPDATE=false
MOBILE_STORE_URL_ANDROID=
MOBILE_STORE_URL_IOS=

# Hosted legal pages (admin /legal/* or client site). Exposed on GET /config/public
# Production: replace localhost with the Client admin origin (see docs/READINESS_LEGAL_URLS_RUNBOOK.md)
LEGAL_PRIVACY_URL=http://localhost:3000/legal/privacy
LEGAL_TERMS_URL=http://localhost:3000/legal/terms
LEGAL_DELETE_ACCOUNT_URL=http://localhost:3000/legal/delete-account
LEGAL_SUPPORT_EMAIL=support@demo.jewellers.local

# API maintenance (keeps /health and /ready up)
MAINTENANCE_MODE=false
